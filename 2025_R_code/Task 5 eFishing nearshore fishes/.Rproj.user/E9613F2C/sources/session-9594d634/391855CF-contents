# Calculate CPUE at the segment level (by species), then summarize by species 
# (across all unique segments).

# 2025 catch table-----------------------------------------------------------------------------------
CPUE_2025 <- EFISH_2025 %>%
  dplyr::select(TransectID, FieldYear, Subregion, SampleDate, StartTime, SegmentNumber, SecondsPerSegment, 
                CommonName, OrganismCode, Count) %>%
  dplyr::mutate(CommonName=ifelse(OrganismCode == "LAMAM","Lamprey ammocete",
                                  CommonName)) %>%
  dplyr::filter(!is.na(SecondsPerSegment)) %>%
  dplyr::filter(!CommonName %in% c("No Catch","no catch")) %>%
  dplyr::filter(!CommonName %in% c("Centrarchid unknown")) %>%
  dplyr::filter(FieldYear == 2025) %>%
  dplyr::group_by(TransectID, FieldYear,Subregion, SampleDate, StartTime, SegmentNumber, SecondsPerSegment, 
                  CommonName) %>%
  dplyr::summarize(TotalCount=sum(Count),
                   .groups="drop") %>%
  tidyr::pivot_wider(id_cols=c(TransectID, FieldYear,Subregion, SampleDate, StartTime, SegmentNumber,
                               SecondsPerSegment),
                     names_from=CommonName,
                     values_from=TotalCount,
                     values_fill=0) %>%
  tidyr::pivot_longer(cols=-c(TransectID, FieldYear,Subregion, SampleDate, StartTime, SegmentNumber, 
                              SecondsPerSegment),
                      names_to="CommonName",
                      values_to="TotalCount") %>%
  dplyr::mutate(CPUE_per_minute=TotalCount/(SecondsPerSegment/60)) %>%
  dplyr::group_by(CommonName) %>%
  dplyr::summarize(TotalCount=sum(TotalCount),
                   MeanCPUE=mean(CPUE_per_minute),
                   SDCPUE=sd(CPUE_per_minute),
                   .groups="drop") %>%
  dplyr::mutate(PercentCatch=TotalCount/sum(TotalCount)*100)


write.csv(CPUE_2025, paste0("EFish_CPUE_",TargetFieldYear,"_FY.csv"), row.names=FALSE)

